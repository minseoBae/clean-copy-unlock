{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.2.0",
  "default_locale": "ko",
  "description": "__MSG_extDescription__",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extName__"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
